{
    "require": {
        "laravel/sanctum": "^2.15",
        "laravel/framework": "^9.52",
        "php": "^8.0",
        "symfony/http-foundation": "^6.0",
        "symfony/process": "^6.0",
        "symfony/http-kernel": "^6.0",
        "symfony/console": "^6.0",
        "symfony/event-dispatcher": "^6.0",
        "symfony/routing": "^6.0",
        "symfony/finder": "^6.0",
        "symfony/string": "^6.0",
        "symfony/translation": "^6.0"
    },
    "require-dev": {
        "mockery/mockery": "^1.6",
        "fakerphp/faker": "^1.24",
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Database\\Seeders\\": "database/seeders/",
            "Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "platform": {
            "php": "8.0.30"
        }
    }
}
