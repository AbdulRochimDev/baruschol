{
    "require": {
        "laravel/sanctum": "^4.2",
        "laravel/framework": "^12.0"
    },
    "require-dev": {
        "pestphp/pest": "^4.1",
        "mockery/mockery": "^1.6",
        "fakerphp/faker": "^1.24"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Database\\Seeders\\": "database/seeders/",
            "Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
